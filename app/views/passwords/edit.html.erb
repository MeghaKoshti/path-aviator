<% content_for :title, "Choose a new password" %>

<h1 class="type-display text-2xl text-ink sm:text-[1.75rem]">Choose a new password</h1>
<p class="mt-2 text-pretty text-ink-muted">You’ll use it the next time you sign in.</p>

<%= form_with url: password_path(params[:token]), method: :put, class: "mt-8 space-y-5" do |form| %>
  <%= render "shared/field", form: form, attribute: :password, label: "New password", as: :password_field, reveal: true,
        hint: "At least 8 characters.",
        input: { required: true, autofocus: true, autocomplete: "new-password", minlength: 8, maxlength: 72 } %>

  <%= render "shared/field", form: form, attribute: :password_confirmation, label: "Confirm new password", as: :password_field,
        input: { required: true, autocomplete: "new-password", maxlength: 72 } %>

  <%= form.submit "Save new password", class: ui_button_classes(size: :lg, block: true), data: { turbo_submits_with: "Saving…" } %>
<% end %>

<% content_for :below_card do %>
  <%= link_to "Back to sign in", new_session_path, class: "font-semibold text-brand-700 underline-offset-4 hover:underline" %>
<% end %>
