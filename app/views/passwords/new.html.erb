<% content_for :title, "Reset your password" %>

<h1 class="type-display text-2xl text-ink sm:text-[1.75rem]">Reset your password</h1>
<p class="mt-2 text-pretty text-ink-muted">Enter the email you signed up with and we’ll send you a link to choose a new password.</p>

<%= form_with url: passwords_path, class: "mt-8 space-y-5" do |form| %>
  <%= render "shared/field", form: form, attribute: :email_address, label: "Email", as: :email_field,
        input: { value: params[:email_address], required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com" } %>

  <%= form.submit "Email me a reset link", class: ui_button_classes(size: :lg, block: true), data: { disable_with: "Sending…" } %>
<% end %>

<% content_for :below_card do %>
  Remembered it?
  <%= link_to "Back to sign in", new_session_path, class: "font-semibold text-brand-700 underline-offset-4 hover:underline" %>
<% end %>
