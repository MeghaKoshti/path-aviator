<% content_for :title, @title %>
<% if authenticated? %>
  <%= render "shared/empty_state", title: @title, body: @body %>
<% else %>
  <h1 class="type-display text-2xl text-ink"><%= @title %></h1>
  <p class="mt-3 text-ink-muted"><%= @body %></p>
  <div class="mt-6"><%= ui_button "Sign in", new_session_path, block: true %></div>
<% end %>
