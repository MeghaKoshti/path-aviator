<% content_for :title, @pro ? "Welcome to Pro" : "Confirming your payment" %>
<%# The provider's webhook usually lands within seconds; check again until it has. %>
<% content_for :head, tag.meta("http-equiv": "refresh", content: "3") unless @pro %>
<div class="mx-auto max-w-xl">
  <div class="rounded-panel border border-line bg-surface-raised p-6 text-center shadow-panel sm:p-10">
    <% if @pro %>
      <h1 class="type-display text-3xl text-balance text-ink">You’re on Pro</h1>
      <p class="mt-3 text-pretty text-ink-muted">Thanks for supporting Path Aviator. You can now plan up to <%= Plan.pro.monthly_generations %> paths a month.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <%= ui_button "Plan a new path", new_learning_goal_path, size: :lg %>
        <%= ui_button "Go to dashboard", dashboard_path, variant: :secondary, size: :lg %>
      </div>
    <% else %>
      <h1 class="type-display text-3xl text-balance text-ink">Confirming your payment…</h1>
      <p class="mt-3 text-pretty text-ink-muted" role="status">This usually takes a few seconds and the page updates by itself. If you cancelled, nothing was charged.</p>
      <div class="mt-8"><%= ui_button "Back to settings", settings_path(anchor: "plan"), variant: :secondary %></div>
    <% end %>
  </div>
</div>
