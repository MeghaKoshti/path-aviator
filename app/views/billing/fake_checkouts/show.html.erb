<% content_for :title, "Test checkout" %>
<% interval = @checkout[:interval] %>
<% currency = @checkout[:currency] %>
<div class="mx-auto max-w-md">
  <p class="mb-4 rounded-control border border-warning-600/40 bg-warning-50 px-4 py-3 text-sm font-medium text-warning-700" role="note">
    Test checkout: the fake payment provider used in development. No money moves.
  </p>
  <%= render "shared/card", title: "Path Aviator Pro" do %>
    <dl class="space-y-2 text-ink">
      <div class="flex justify-between gap-4"><dt class="text-ink-muted">Billing</dt><dd><%= interval == "year" ? "Yearly" : "Monthly" %></dd></div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-muted">Total</dt>
        <dd class="font-semibold tabular-nums"><%= plan_price(Plan.pro, currency:, interval:) %> <span class="font-normal text-ink-subtle"><%= price_tax_note(currency) %></span></dd>
      </div>
      <div class="flex justify-between gap-4"><dt class="text-ink-muted">Account</dt><dd class="truncate"><%= Current.user.email_address %></dd></div>
    </dl>
    <div class="mt-6 flex flex-col gap-2">
      <%= ui_button "Pay #{plan_price(Plan.pro, currency:, interval:)} (test)", billing_fake_checkout_path(params[:token]), method: :post, size: :lg, block: true,
            data: { turbo_submits_with: "Paying…" } %>
      <%= ui_button "Cancel", settings_path(anchor: "plan"), variant: :ghost, block: true %>
    </div>
  <% end %>
</div>
