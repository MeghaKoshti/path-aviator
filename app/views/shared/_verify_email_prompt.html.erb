<%#
  Asks an unconfirmed user to click the emailed link, with a resend button.
  Locals: user: (default Current.user), blocking: true when it stands in for a
  form the user can't use yet (bigger, explains why).
%>
<% user = local_assigns[:user] || Current.user %>
<% blocking = local_assigns.fetch(:blocking, false) %>
<section id="verify_email" aria-labelledby="verify-email-heading"
         class="<%= class_names("rounded-panel border border-warning-600/40 bg-warning-50", blocking ? "p-6 sm:p-8" : "px-5 py-4") %>">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex min-w-0 items-start gap-3">
      <svg class="mt-0.5 size-5 shrink-0 text-warning-700" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.75" y="4.75" width="14.5" height="10.5" rx="1.5"/><path d="m3.5 5.5 6.5 5 6.5-5"/></svg>
      <div class="min-w-0">
        <h2 id="verify-email-heading" class="<%= class_names("font-semibold text-ink", "text-lg": blocking) %>">
          <%= blocking ? "Confirm your email to plan more paths" : "Confirm your email address" %>
        </h2>
        <p class="mt-1 text-sm text-pretty text-ink-muted">
          We sent a link to <span class="font-medium text-ink"><%= user.email_address %></span>.
          <%= blocking ? "Your first path is free to try; confirming keeps fake accounts out." : "Your first path works without it; confirm to plan more." %>
        </p>
      </div>
    </div>
    <%= ui_button "Resend the link", email_verification_path, method: :post, variant: :secondary, size: :sm, class: "shrink-0 self-start sm:self-auto" %>
  </div>
</section>
