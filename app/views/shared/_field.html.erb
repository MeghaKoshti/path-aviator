<%#
  Labelled form field with optional hint and inline error.
  Locals: form:, attribute:, label:
          as: form builder method (default :text_field), hint:, error:, reveal: (password show/hide), input: {html options}
  The error falls back to the form object's first message for the attribute.
%>
<%
  as = local_assigns.fetch(:as, :text_field)
  hint = local_assigns[:hint]
  input = local_assigns.fetch(:input, {})
  reveal = local_assigns.fetch(:reveal, false)
  field_id = form.field_id(attribute)
  object = form.object
  error = local_assigns[:error] || (object.errors.full_messages_for(attribute).first if object.respond_to?(:errors))
  hint_id = "#{field_id}_hint" if hint
  error_id = "#{field_id}_error" if error
  # No explicit id: the builder's default matches field_id, including any form namespace.
  input_options = input.merge(
    class: class_names(ui_input_classes(invalid: error.present?), input[:class], "pr-12": reveal),
    aria: { invalid: error.present? || nil, describedby: [ hint_id, error_id ].compact.join(" ").presence }
  )
  input_options[:data] = (input[:data] || {}).merge(password_visibility_target: "input") if reveal
%>
<div class="space-y-1.5">
  <%= form.label attribute, label, for: field_id, class: "block text-sm font-semibold text-ink" %>

  <% if reveal %>
    <div class="relative" data-controller="password-visibility">
      <%= form.public_send(as, attribute, input_options) %>
      <button type="button"
              class="absolute inset-y-0 right-1 my-1 inline-flex w-10 items-center justify-center rounded-md text-ink-subtle hover:bg-surface-sunken hover:text-ink"
              aria-label="Show password" aria-pressed="false"
              data-password-visibility-target="toggle"
              data-action="password-visibility#toggle">
        <svg data-password-visibility-target="showIcon" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
        <svg data-password-visibility-target="hideIcon" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6A17.6 17.6 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
      </button>
    </div>
  <% else %>
    <%= form.public_send(as, attribute, input_options) %>
  <% end %>

  <% if hint %>
    <p id="<%= hint_id %>" class="text-sm text-ink-subtle"><%= hint %></p>
  <% end %>
  <% if error %>
    <p id="<%= error_id %>" class="flex items-start gap-1.5 text-sm font-medium text-danger-600">
      <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm-.75-11.5a.75.75 0 0 1 1.5 0v4a.75.75 0 0 1-1.5 0v-4ZM10 15a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
      <%= error %>
    </p>
  <% end %>
</div>
