<%#
  Empty state: an invitation to act.
  Locals: title:, body: (optional), action_label: + action_href: (optional primary button)
  action: (optional HTML, e.g. a button_to) replaces the default button.
%>
<div class="flex flex-col items-center rounded-panel border border-dashed border-line-strong/60 bg-surface-raised px-6 py-12 text-center sm:px-12">
  <svg class="mb-5 h-14 w-28 text-route" viewBox="0 0 112 56" fill="none" aria-hidden="true">
    <path d="M8 46 C 34 46, 36 12, 60 14 S 92 30, 104 10" stroke="currentColor" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round"/>
    <circle cx="8" cy="46" r="5" class="fill-surface-raised" stroke="currentColor" stroke-width="2"/>
    <path d="M104 4 l6 10 h-12 z" fill="currentColor"/>
  </svg>
  <h2 class="text-lg font-semibold text-ink"><%= title %></h2>
  <% if local_assigns[:body] %>
    <p class="mt-2 max-w-md text-ink-muted"><%= body %></p>
  <% end %>
  <% if local_assigns[:action] %>
    <div class="mt-6"><%= action %></div>
  <% elsif local_assigns[:action_label] && local_assigns[:action_href] %>
    <div class="mt-6"><%= ui_button action_label, action_href %></div>
  <% end %>
</div>
