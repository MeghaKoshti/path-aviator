<%# Plan & billing. Locals: user: %>
<%
  quota = user.generation_quota
  subscription = user.current_subscription
  currency = billing_currency
  can_upgrade = user.free? && !user.demo? && Billing.available?
%>
<section id="plan" class="scroll-mt-24 rounded-panel border border-line bg-surface-raised p-6 shadow-panel sm:p-8" aria-labelledby="plan-heading">
  <div class="flex flex-wrap items-center gap-2">
    <h2 id="plan-heading" class="text-lg font-semibold text-ink">Plan &amp; billing</h2>
    <%= ui_badge user.current_plan.name, user.pro? ? :brand : :neutral %>
  </div>
  <p class="mt-2 text-pretty text-ink-muted">
    <% if quota.unlimited? %>
      The demo account can plan as many paths as it likes, but it can’t buy Pro.
    <% else %>
      <%= generations_left_label(quota) %>. New paths and regenerations both count, and the count resets on <%= l(quota.resets_on, format: "%-d %B") %>.
    <% end %>
  </p>

  <% if subscription %>
    <div id="subscription" class="mt-5 rounded-control border border-line bg-surface p-4">
      <p class="font-semibold text-ink">
        Pro, <%= subscription.interval == "year" ? "yearly" : "monthly" %>
        <span class="font-normal text-ink-muted">· <%= plan_price(subscription.plan_details, currency: subscription.currency, interval: subscription.interval) %></span>
      </p>
      <% period_end = subscription.current_period_end && l(subscription.current_period_end.to_date, format: "%-d %B %Y") %>
      <% if subscription.past_due? %>
        <p class="mt-1 text-sm font-medium text-pretty text-danger-700" role="alert">
          Your last payment didn’t go through. Update your card to keep Pro<%= " (we’ll keep it until #{l(subscription.grace_ends_at.to_date, format: "%-d %B")})" if subscription.grants_pro? && subscription.grace_ends_at %>.
        </p>
      <% else %>
        <p class="mt-1 text-sm text-pretty text-ink-muted">
          <% if subscription.expired? || (subscription.canceled? && !subscription.grants_pro?) %>
            Ended<%= " on #{period_end}" if period_end %>.
          <% elsif subscription.cancel_at_period_end? || subscription.canceled? %>
            Cancelled. You keep Pro until <%= period_end %>, then move to Free.
          <% elsif period_end %>
            Renews on <%= period_end %>.
          <% end %>
        </p>
      <% end %>
      <% unless subscription.expired? %>
        <div class="mt-3">
          <%# Off Turbo: the answer is a redirect to the provider's site. %>
          <%= ui_button subscription.past_due? ? "Update payment method" : "Manage or cancel", billing_portal_path, method: :post,
                variant: subscription.past_due? ? :primary : :secondary, size: :sm, data: { turbo: false } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if can_upgrade %>
    <div class="mt-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="font-semibold text-ink">Upgrade to Pro</h3>
        <p class="text-sm text-ink-muted">
          Prices in
          <% Billing::CURRENCIES.each do |code| %>
            <%= link_to code.upcase, settings_path(currency: code, anchor: "plan"),
                  class: class_names("rounded-md px-1.5 py-0.5 font-semibold", code == currency ? "bg-brand-50 text-brand-700" : "text-ink-muted hover:text-ink"),
                  aria: { current: (code == currency || nil) } %>
          <% end %>
        </p>
      </div>
      <p class="mt-1 text-sm text-pretty text-ink-muted">Up to <%= Plan.pro.monthly_generations %> paths a month, a weekly re-check of your links, job-post paths and certificates.</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2" role="list">
        <% Billing::INTERVALS.each do |interval| %>
          <li class="flex flex-col rounded-control border border-line p-4">
            <p class="text-sm font-semibold text-ink-muted"><%= interval == "year" ? "Yearly" : "Monthly" %></p>
            <p class="mt-1 text-2xl font-semibold tabular-nums text-ink">
              <%= plan_price(Plan.pro, currency:, interval:) %><span class="text-base font-normal text-ink-muted"> / <%= interval %></span>
            </p>
            <p class="mt-0.5 text-sm text-ink-subtle">
              <%= [ price_tax_note(currency), ("save #{yearly_savings_percent(Plan.pro, currency:)}%" if interval == "year") ].compact.join(", ").presence || "Cancel any time" %>
            </p>
            <div class="mt-4">
              <%= ui_button "Upgrade #{interval == "year" ? "yearly" : "monthly"}", billing_checkout_path(interval:, currency:), method: :post,
                    variant: interval == "year" ? :primary : :secondary, size: :sm, block: true,
                    data: { turbo: false } %>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="mt-3 text-sm text-ink-subtle">Secure checkout by our payment partner. Cancel any time; you keep Pro until the end of the period you paid for.</p>
    </div>
  <% end %>
</section>
