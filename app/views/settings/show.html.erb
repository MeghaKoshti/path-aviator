<% content_for :title, "Settings" %>

<div class="mx-auto max-w-2xl">
  <h1 class="type-display text-3xl text-ink sm:text-4xl">Settings</h1>
  <p class="mt-2 text-ink-muted">Manage how you sign in to Path Aviator.</p>

  <div class="mt-8 space-y-6">
    <%= render "shared/card", title: "Profile" do %>
      <% invalid = first_invalid_field(@profile, %i[name email_address password_challenge]) %>
      <%= form_with model: @profile, url: settings_profile_path, method: :patch, namespace: "profile", class: "space-y-5" do |form| %>
        <%= render "shared/field", form: form, attribute: :name, label: "Name (optional)",
              input: { autocomplete: "name", maxlength: 100, autofocus: invalid == :name } %>
        <%= render "shared/field", form: form, attribute: :email_address, label: "Email", as: :email_field,
              hint: "You sign in with this address.",
              input: { required: true, autocomplete: "username", autofocus: invalid == :email_address } %>
        <%= render "shared/field", form: form, attribute: :password_challenge, label: "Current password", as: :password_field, reveal: true,
              hint: "Only needed if you change your email.",
              input: { autocomplete: "current-password", maxlength: 72, value: nil, autofocus: invalid == :password_challenge } %>
        <%= form.submit "Save profile", class: ui_button_classes, data: { turbo_submits_with: "Saving…" } %>
      <% end %>
    <% end %>

    <%= render "shared/card", title: "Password" do %>
      <% invalid = first_invalid_field(@password_change, %i[password_challenge password password_confirmation]) %>
      <%= form_with model: @password_change, url: settings_password_path, method: :patch, scope: :user, namespace: "password_change", class: "space-y-5" do |form| %>
        <%= render "shared/field", form: form, attribute: :password_challenge, label: "Current password", as: :password_field, reveal: true,
              input: { required: true, autocomplete: "current-password", maxlength: 72, value: nil, autofocus: invalid == :password_challenge } %>
        <%= render "shared/field", form: form, attribute: :password, label: "New password", as: :password_field, reveal: true,
              hint: "At least 8 characters. You’ll stay signed in here; other devices are signed out.",
              input: { required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, autofocus: invalid == :password } %>
        <%= render "shared/field", form: form, attribute: :password_confirmation, label: "Confirm new password", as: :password_field,
              input: { required: true, autocomplete: "new-password", maxlength: 72, autofocus: invalid == :password_confirmation } %>
        <%= form.submit "Change password", class: ui_button_classes, data: { turbo_submits_with: "Changing…" } %>
      <% end %>
    <% end %>

    <section class="rounded-panel border border-danger-600/40 bg-surface-raised p-6 shadow-panel sm:p-8" aria-labelledby="delete-account-heading">
      <h2 id="delete-account-heading" class="mb-2 text-lg font-semibold text-ink">Delete account</h2>
      <p class="text-pretty text-ink-muted">
        This deletes your account, <%= pluralize(Current.user.learning_paths.count, "learning path") %> and all your progress.
        It can’t be undone.
      </p>
      <%= form_with url: settings_account_path, method: :delete, class: "mt-5 space-y-5" do |form| %>
        <%= render "shared/field", form: form, attribute: :confirmation, label: "Type DELETE or your email to confirm",
              error: @deletion_error,
              input: { required: true, autocomplete: "off", autocapitalize: "characters", spellcheck: false, autofocus: @deletion_error.present? } %>
        <%= form.submit "Delete my account", class: ui_button_classes(variant: :danger), data: { turbo_submits_with: "Deleting…" } %>
      <% end %>
    </section>
  </div>
</div>
