<%
  first_time = !Current.user.onboarded?
  from_job_post = @learning_goal.from_job_post
  job_post_locked = from_job_post && !Current.user.can_plan_from_job_post?
  content_for :title, first_time ? "Plan your first path" : "Plan a new path"
%>

<div class="mx-auto max-w-2xl">
  <% if first_time %>
    <h1 class="type-display text-3xl text-ink sm:text-4xl">
      <%= Current.user.name ? "Welcome, #{Current.user.name.split.first}. Where to first?" : "Welcome aboard. Where to first?" %>
    </h1>
  <% else %>
    <h1 class="type-display text-3xl text-ink sm:text-4xl">Plan a new path</h1>
  <% end %>
  <p class="mt-3 text-lg text-pretty text-ink-muted">
    <% if from_job_post %>
      Paste the job you want. Path Aviator finds the skills it asks for and plans the gaps, week by week.
    <% elsif first_time %>
      Three quick questions, then Path Aviator plans your route.
    <% else %>
      Pick a topic, your level and the time you have. Your other paths stay as they are.
    <% end %>
  </p>

  <%# Two ways to start. Plain links, so each is its own page and works without JavaScript. %>
  <nav aria-label="How to plan" class="mt-8 grid grid-cols-2 gap-1 rounded-control bg-surface-sunken p-1">
    <% [ [ "Start from a topic", new_learning_goal_path, !from_job_post ], [ "I have a job post", new_learning_goal_path(from: "job_post"), from_job_post ] ].each do |label, href, current| %>
      <%= link_to label, href, aria: { current: ("page" if current) },
            class: class_names("rounded-[calc(var(--radius-control)-2px)] px-3 py-2.5 text-center text-sm font-semibold transition-colors sm:text-[0.9375rem]",
                               current ? "bg-surface-raised text-ink shadow-sm ring-1 ring-line" : "text-ink-muted hover:text-ink") %>
    <% end %>
  </nav>

  <% if job_post_locked %>
    <section class="mt-6 rounded-panel border border-line bg-surface-raised p-6 shadow-panel sm:p-8" aria-labelledby="job-post-locked-heading">
      <h2 id="job-post-locked-heading" class="text-lg font-semibold text-ink">Planning from a job post is part of Pro</h2>
      <p class="mt-2 max-w-prose text-pretty text-ink-muted">
        Your first job-post path was free. Pro plans as many as you need, each sized to your interview date.
        You can still plan any path from a topic.
      </p>
      <% if lookup_context.exists?("upgrade_prompt", [ "shared" ], true) %>
        <div class="mt-5"><%= render "shared/upgrade_prompt", reason: :job_post_paths %></div>
      <% else %>
        <div class="mt-5 flex flex-wrap gap-3">
          <% if respond_to?(:pricing_path) %>
            <%= ui_button "See Pro", pricing_path %>
          <% end %>
          <%= ui_button "Start from a topic", new_learning_goal_path, variant: :secondary %>
        </div>
      <% end %>
    </section>
  <% elsif @refusal == :limit %>
    <div class="mt-6"><%= render "shared/upgrade_prompt", reason: :limit %></div>
  <% elsif @refusal == :unverified %>
    <div class="mt-6"><%= render "shared/verify_email_prompt", blocking: true %></div>
  <% elsif @refusal %>
    <p class="mt-6 rounded-control bg-warning-50 px-4 py-3 font-medium text-warning-700" role="alert"><%= generation_quota.refusal_message(@refusal) %></p>
  <% else %>
    <%= turbo_frame_tag "onboarding", class: "mt-6 block",
          data: { controller: "onboarding", action: "turbo:frame-missing->onboarding#followRedirect" } do %>
      <%= render "form", learning_goal: @learning_goal %>
    <% end %>
  <% end %>
</div>
