<%
  path = @learning_path
  steps = path.path_steps.to_a
  holder = certificate_holder_name(path)
  points = certificate_route_points(steps.size)
%>
<% content_for :title, "#{holder}: #{path.title}" %>
<% content_for :og_title, "#{holder} completed “#{path.title}”" %>
<% content_for :meta_description, "Certificate of completion from Path Aviator: #{pluralize(steps.size, "step")}, #{format_minutes(path.total_minutes)} of study, finished #{l(path.finished_at.to_date, format: :legal)}." %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-3xl px-4 pb-16 pt-6 sm:px-6 sm:pt-10">
  <% if @owner_viewing %>
    <section class="mb-8 rounded-panel border border-line bg-surface-raised p-5 shadow-panel" aria-labelledby="owner-tools"
             data-controller="clipboard" data-clipboard-path-value="<%= certificate_path(path.certificate_token) %>">
      <h2 id="owner-tools" class="text-sm font-semibold text-ink">Only you see this panel</h2>
      <p class="mt-1 text-sm text-ink-muted">Anyone with the link sees the certificate below. Your notes and email stay private.</p>
      <label for="certificate_url" class="sr-only">Certificate link</label>
      <input type="text" readonly id="certificate_url" value="<%= certificate_url(path.certificate_token) %>"
             class="<%= ui_input_classes %> mt-4" data-clipboard-target="source" data-action="focus->clipboard#select">
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= ui_button nil, linkedin_add_to_profile_url(path), size: :sm, target: "_blank", rel: "noopener" do %>Add to LinkedIn<span class="sr-only"> (opens in a new tab)</span><% end %>
        <%= ui_button "Copy link", variant: :secondary, size: :sm, data: { action: "clipboard#copy" } %>
        <%= ui_button "Edit evidence links", new_learning_path_certificate_path(path), variant: :ghost, size: :sm %>
        <%= ui_button "Revoke", learning_path_certificate_path(path), method: :delete, variant: :danger_ghost, size: :sm,
              data: { turbo_confirm: "Revoke this certificate? Its link will stop working, including on LinkedIn." } %>
        <p class="text-sm font-medium text-success-700" role="status" data-clipboard-target="status"></p>
      </div>
    </section>
  <% end %>

  <article class="overflow-hidden rounded-panel border border-line bg-surface-raised shadow-pop" aria-labelledby="certificate-title">
    <div class="relative bg-brand-900 px-6 pb-4 pt-6 sm:px-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <%= render "shared/logo", tone: :light %>
        <p class="text-sm font-medium text-brand-100">Certificate of completion</p>
      </div>
      <svg class="mt-4 h-16 w-full" viewBox="0 0 640 72" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <polyline points="<%= points.map { |x, y| "#{x},#{y}" }.join(" ") %>" class="stroke-route" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      </svg>
      <%# Waypoints drawn as HTML so they stay round when the band stretches. %>
      <ol class="pointer-events-none absolute inset-x-6 bottom-4 h-16 sm:inset-x-10" aria-hidden="true">
        <% points.each_with_index do |(x, y), index| %>
          <li class="absolute -translate-x-1/2 -translate-y-1/2" style="left: <%= (x / 6.4).round(2) %>%; top: <%= (y / 0.72).round(2) %>%">
            <% if index == points.size - 1 %>
              <svg class="size-4 text-white" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l7 13H1z"/></svg>
            <% else %>
              <span class="block size-3 rounded-full bg-route ring-2 ring-brand-900"></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </div>

    <div class="px-6 py-8 sm:px-10 sm:py-10">
      <p class="text-ink-muted">This certifies that</p>
      <p class="type-display mt-2 text-3xl text-balance text-ink sm:text-[2.75rem]"><%= holder %></p>
      <p class="mt-5 text-ink-muted">completed every step of the learning path</p>
      <h1 id="certificate-title" class="mt-2 text-2xl font-semibold text-balance text-ink"><%= path.title %></h1>

      <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-line py-6 sm:grid-cols-4">
        <div><dt class="text-sm text-ink-subtle">Steps</dt><dd class="mt-0.5 font-semibold tabular-nums text-ink"><%= steps.size %> of <%= steps.size %></dd></div>
        <div><dt class="text-sm text-ink-subtle">Study time</dt><dd class="mt-0.5 font-semibold tabular-nums text-ink"><%= format_minutes(path.total_minutes) %></dd></div>
        <div><dt class="text-sm text-ink-subtle">Started</dt><dd class="mt-0.5 font-semibold text-ink"><time datetime="<%= path.started_at.to_date.iso8601 %>"><%= l path.started_at.to_date, format: :legal %></time></dd></div>
        <div><dt class="text-sm text-ink-subtle">Finished</dt><dd class="mt-0.5 font-semibold text-ink"><time datetime="<%= path.finished_at.to_date.iso8601 %>"><%= l path.finished_at.to_date, format: :legal %></time></dd></div>
      </dl>

      <h2 class="mt-8 font-semibold text-ink">The route</h2>
      <ol class="mt-4 space-y-4">
        <% steps.each do |step| %>
          <li class="flex gap-4">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-route-soft text-sm font-semibold tabular-nums text-route"><%= step.position %></span>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-pretty text-ink"><%= step.title %></p>
              <p class="mt-0.5 text-sm text-ink-subtle">
                <%= resource_type_label(step.resource_type) %>, <%= format_minutes(step.estimated_minutes) %>.
                Done <time datetime="<%= step.completed_at.to_date.iso8601 %>"><%= l step.completed_at.to_date, format: :legal %></time>.
              </p>
              <% if step.evidence_url %>
                <%= link_to step.evidence_url, rel: "nofollow noopener", target: "_blank", class: "mt-1 inline-flex max-w-full items-center gap-1 text-sm font-semibold text-brand-700 underline-offset-4 hover:underline" do %>
                  <span class="truncate">See the work</span><span class="sr-only"> for “<%= step.title %>” (opens in a new tab)</span>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </div>

    <footer class="border-t border-line bg-surface px-6 py-5 text-sm text-ink-muted sm:px-10">
      <p>Issued by Path Aviator on <time datetime="<%= path.certificate_issued_at.to_date.iso8601 %>"><%= l path.certificate_issued_at.to_date, format: :legal %></time>.
        Certificate ID <span class="font-medium text-ink"><%= path.certificate_token %></span>.</p>
      <p class="mt-1">Steps are ticked off by the learner; evidence links point to their own work.</p>
    </footer>
  </article>

  <% unless @owner_viewing %>
    <p class="mt-8 text-center text-ink-muted">
      Want a plan like this? <%= link_to "Plan your own path", new_registration_path, class: "font-semibold text-brand-700 underline-offset-4 hover:underline" %>
    </p>
  <% end %>
</div>
