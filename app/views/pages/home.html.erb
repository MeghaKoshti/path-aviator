<% content_for :title, "Turn a job post into a study plan you’ll finish" %>
<% content_for :head, json_ld_tag(software_application_ld) %>
<% content_for :meta_description, "Paste a job post or name a skill. Path Aviator plans a week-by-week route around the hours you have after work, with checked links and a public progress page for your CV." %>

<%# Hero %>
<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-chart-grid [mask-image:linear-gradient(to_bottom,black,transparent_85%)]" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-10 [&>*]:min-w-0 sm:px-6 sm:pt-16 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pb-28 lg:pt-20">
    <div class="max-w-xl">
      <h1 id="hero-title" class="type-display text-[2.5rem] text-balance text-ink sm:text-6xl">
        Turn the job post into a plan you’ll finish.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-pretty text-ink-muted">
        Paste the job description or name the skill. Path Aviator plans a week-by-week route
        around the hours you have after work, links only to courses and docs it has checked,
        and gives you a public progress page to put on your CV.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= ui_button "Plan my first path", new_registration_path, size: :lg %>
        <%= ui_button "See pricing", pricing_path, variant: :secondary, size: :lg %>
      </div>
      <p class="mt-4 text-sm text-ink-subtle"><%= Plan.free.monthly_generations %> paths a month free. No card needed.</p>
    </div>

    <%= render "pages/flight_plan" %>
  </div>
</section>

<%# How it works: a real sequence, so the steps are numbered and joined by a route line. %>
<section class="border-t border-line bg-surface-raised" aria-labelledby="how-title">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <h2 id="how-title" class="type-display text-3xl text-ink sm:text-4xl">How it works</h2>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">

      <% [
        [ "Paste the job post, or name the skill", "Add your current level and the hours you can give it each week, say six hours after work." ],
        [ "Get a week-by-week route", "In about a minute: 6 to 12 steps of courses, docs, videos and practice, each with a time estimate and a checked link." ],
        [ "Show what you’ve done", "Tick steps off and keep your streak. Share a public progress page with recruiters, and add a certificate to LinkedIn when you finish." ]
      ].each_with_index do |(title, body), index| %>
        <li class="relative pl-16 md:pl-0">
          <% if index < 2 %>
            <%# Route leg to the next step: down on phones, across from md up (bridges the grid gap). %>
            <span class="absolute -bottom-10 left-5 top-10 border-l-2 border-dashed border-route/50 md:-right-8 md:bottom-auto md:left-10 md:top-5 md:border-l-0 md:border-t-2" aria-hidden="true"></span>
          <% end %>
          <span class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-full border-2 border-route bg-surface-raised font-semibold text-route md:relative">
            <%= index + 1 %>
          </span>
          <h3 class="text-lg font-semibold text-ink md:mt-5"><%= title %></h3>
          <p class="mt-2 max-w-sm leading-relaxed text-ink-muted"><%= body %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<%# What you get %>
<section class="border-t border-line" aria-labelledby="features-title">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_2fr] lg:py-24">
    <div>
      <h2 id="features-title" class="type-display text-3xl text-ink sm:text-4xl">Built for the switch, not just the plan</h2>
      <p class="mt-4 max-w-sm leading-relaxed text-ink-muted">Any chatbot can write a study plan. The hard part is week two. Path Aviator is built for the weeks after.</p>
    </div>

    <dl class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
      <% [
        [ "Links that work", "Every step is a real course, doc, video or exercise, checked when your path is planned. No dead pages, no made-up URLs.",
          "M4 6h16M4 12h10M4 18h6" ],
        [ "Sized to your evenings", "Paths respect the hours you set, so six hours a week after work gets a different route than fifteen.",
          "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" ],
        [ "Accountability that sticks", "Weekly stats and a streak show when you’re slipping, while there’s still time to catch up.",
          "M4 19V5m5 14v-6m5 6V9m5 10V4" ],
        [ "Proof for interviews", "A public progress page for your CV and, when you finish, a certificate you can add to LinkedIn.",
          "M9 12l2 2 4-4M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3Z" ]
      ].each do |title, body, icon| %>
        <div>
          <dt class="flex items-center gap-3 font-semibold text-ink">
            <span class="flex size-9 items-center justify-center rounded-control bg-brand-50 text-brand-700" aria-hidden="true">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="<%= icon %>"/></svg>
            </span>
            <%= title %>
          </dt>
          <dd class="mt-3 leading-relaxed text-ink-muted"><%= body %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>

<%# Pricing teaser: the monthly Pro price in the visitor's currency. %>
<section class="border-t border-line bg-surface-raised" aria-labelledby="pricing-title"
         data-controller="pricing" data-pricing-interval-value="month"
         data-pricing-currency-value="<%= pricing_currency %>" data-pricing-chosen-value="<%= pricing_currency_chosen? %>">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-20 sm:px-6 md:flex-row md:items-end md:justify-between lg:py-24">
    <div class="max-w-2xl">
      <h2 id="pricing-title" class="type-display text-3xl text-ink sm:text-4xl">Start free. Go Pro for the push.</h2>
      <p class="mt-4 text-lg leading-relaxed text-pretty text-ink-muted">
        Free gives you <%= Plan.free.monthly_generations %> new paths a month.
        Pro is <% Plan::CURRENCIES.each do |currency| %><%= pricing_variant(currency:, class: "font-semibold text-ink") { "#{plan_price(Plan.pro, currency:, interval: :month)} a month" } %><% end %>
        for unlimited paths, plans from job posts, weekly link checks and a LinkedIn certificate.
        Less than a single online course.
      </p>
    </div>
    <%= ui_button "See pricing", pricing_path, variant: :secondary, size: :lg, class: "shrink-0" %>
  </div>
</section>

<%# Closing call to action %>
<section class="relative overflow-hidden bg-brand-900" aria-labelledby="cta-title">
  <svg class="pointer-events-none absolute inset-0 h-full w-full text-route" viewBox="0 0 1200 320" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M-20 300 C 420 310, 700 290, 900 190 S 1100 40, 1220 20" stroke="currentColor" stroke-width="2" stroke-dasharray="6 9" opacity="0.7" vector-effect="non-scaling-stroke"/>
  </svg>
  <div class="relative mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-20 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 id="cta-title" class="type-display text-3xl text-white sm:text-4xl">Your next role starts with week one.</h2>
      <p class="mt-4 text-lg text-brand-100">Create a free account and plan your first path in about a minute.</p>
    </div>
    <%= ui_button "Plan my first path", new_registration_path, variant: :inverse, size: :lg, class: "shrink-0" %>
  </div>
</section>
