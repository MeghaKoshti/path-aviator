<% content_for :title, "Learning paths for anything" %>

<%# Hero %>
<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-chart-grid [mask-image:linear-gradient(to_bottom,black,transparent_85%)]" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-10 sm:px-6 sm:pt-16 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pb-28 lg:pt-20">
    <div class="max-w-xl">
      <h1 id="hero-title" class="type-display text-[2.5rem] text-ink sm:text-6xl">
        Chart a course for anything you want to learn.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-muted">
        Tell Path Aviator the topic, your level and the hours you have each week.
        It plans a route of courses, docs, videos and practice, step by step,
        and keeps track of how far you’ve come.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= ui_button "Plan my first path", new_registration_path, size: :lg %>
        <%= ui_button "Sign in", new_session_path, variant: :secondary, size: :lg %>
      </div>
    </div>

    <%= render "pages/flight_plan" %>
  </div>
</section>

<%# How it works: a real sequence, so the steps are numbered and joined by a route line. %>
<section class="border-t border-line bg-surface-raised" aria-labelledby="how-title">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <h2 id="how-title" class="type-display text-3xl text-ink sm:text-4xl">How it works</h2>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">

      <% [
        [ "Tell us where you’re headed", "Pick a topic, your current level and the hours you can give it each week. Add a goal if you have one in mind." ],
        [ "Get a route in about a minute", "Path Aviator plans 6 to 12 steps of courses, docs, videos, articles and practice, each with a time estimate." ],
        [ "Fly it one leg at a time", "Tick off steps as you finish them. Your dashboard shows what’s next and how much time is left." ]
      ].each_with_index do |(title, body), index| %>
        <li class="relative pl-16 md:pl-0">
          <% if index < 2 %>
            <%# Route leg to the next step: down on phones, across from md up (bridges the grid gap). %>
            <span class="absolute -bottom-10 left-5 top-10 border-l-2 border-dashed border-route/50 md:-right-8 md:bottom-auto md:left-10 md:top-5 md:border-l-0 md:border-t-2" aria-hidden="true"></span>
          <% end %>
          <span class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-full border-2 border-route bg-surface-raised font-semibold text-route md:relative">
            <%= index + 1 %>
          </span>
          <h3 class="text-lg font-semibold text-ink md:mt-5"><%= title %></h3>
          <p class="mt-2 max-w-sm leading-relaxed text-ink-muted"><%= body %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<%# What you get %>
<section class="border-t border-line" aria-labelledby="features-title">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_2fr] lg:py-24">
    <div>
      <h2 id="features-title" class="type-display text-3xl text-ink sm:text-4xl">What every path includes</h2>
      <p class="mt-4 max-w-sm leading-relaxed text-ink-muted">A plan you can follow on a busy week, built from resources that already exist.</p>
    </div>

    <dl class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
      <% [
        [ "Real resources, in order", "Every step links to an actual course, doc, video or exercise, sequenced so each one builds on the last.",
          "M4 6h16M4 12h10M4 18h6" ],
        [ "Sized to your week", "Paths respect the hours you set, so three hours a week gets a different route than fifteen.",
          "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" ],
        [ "Progress you can see", "Completed steps, percentage done and time remaining, all on one screen.",
          "M4 19V5m5 14v-6m5 6V9m5 10V4" ],
        [ "Change course anytime", "Not happy with a route? Regenerate it, or start a new path for another topic.",
          "M4 12a8 8 0 0 1 13.7-5.7L20 8.6M20 4v4.6h-4.6M20 12a8 8 0 0 1-13.7 5.7L4 15.4M4 20v-4.6h4.6" ]
      ].each do |title, body, icon| %>
        <div>
          <dt class="flex items-center gap-3 font-semibold text-ink">
            <span class="flex size-9 items-center justify-center rounded-control bg-brand-50 text-brand-700" aria-hidden="true">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="<%= icon %>"/></svg>
            </span>
            <%= title %>
          </dt>
          <dd class="mt-3 leading-relaxed text-ink-muted"><%= body %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>

<%# Closing call to action %>
<section class="relative overflow-hidden bg-brand-900" aria-labelledby="cta-title">
  <svg class="pointer-events-none absolute inset-0 h-full w-full text-route" viewBox="0 0 1200 320" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M-20 300 C 420 310, 700 290, 900 190 S 1100 40, 1220 20" stroke="currentColor" stroke-width="2" stroke-dasharray="6 9" opacity="0.7" vector-effect="non-scaling-stroke"/>
  </svg>
  <div class="relative mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-20 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 id="cta-title" class="type-display text-3xl text-white sm:text-4xl">Where do you want to go next?</h2>
      <p class="mt-4 text-lg text-brand-100">Create an account and plan your first path in about a minute.</p>
    </div>
    <%= ui_button "Plan my first path", new_registration_path, variant: :inverse, size: :lg, class: "shrink-0" %>
  </div>
</section>
