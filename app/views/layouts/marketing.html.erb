<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="flex min-h-screen flex-col">
    <%= render "layouts/skip_link" %>

    <header class="mx-auto flex h-18 w-full max-w-6xl items-center gap-3 px-4 sm:px-6">
      <%= render "shared/logo" %>
      <nav aria-label="Account" class="ml-auto flex items-center gap-1 sm:gap-2">
        <% if authenticated? %>
          <%= ui_button "Your dashboard", dashboard_path, size: :sm %>
        <% else %>
          <%= ui_button "Sign in", new_session_path, variant: :ghost, size: :sm %>
          <%= ui_button "Get started", new_registration_path, size: :sm %>
        <% end %>
      </nav>
    </header>

    <%= render "shared/flash" %>

    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <%# Nested layouts (e.g. layouts/legal) hand over their wrapped page as :page_body. %>
      <%= content_for?(:page_body) ? yield(:page_body) : yield %>
    </main>

    <%= render "shared/site_footer" %>
  </body>
</html>
