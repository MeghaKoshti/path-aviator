<meta charset="utf-8">
<%# safe_join, not string interpolation: the title is already escaped and must not be escaped twice. %>
<title><%= content_for?(:title) ? safe_join([ yield(:title), "Path Aviator" ], " | ") : "Path Aviator: learning paths for anything" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Tell Path Aviator what you want to learn and it plans a step-by-step route of courses, docs and practice, then tracks your progress." %>">
<meta name="theme-color" content="#3f2daa">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="icon" href="/icon.png" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">
<link rel="preload" href="<%= asset_path("archivo-variable.woff2") %>" as="font" type="font/woff2" crossorigin="anonymous">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
