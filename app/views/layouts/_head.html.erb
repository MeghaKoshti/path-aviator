<meta charset="utf-8">
<%# page_title uses safe_join, not interpolation: the title is already escaped and must not be escaped twice. %>
<title><%= page_title %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="<%= page_description %>">
<%= render "layouts/social_meta" %>
<meta name="theme-color" content="#3f2daa">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="icon" href="/icon.png" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">
<link rel="preload" href="<%= asset_path("archivo-variable.woff2") %>" as="font" type="font/woff2" crossorigin="anonymous">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
