<%#
  Policy pages: a readable text column with an "On this page" list beside it.
  The page view registers its sections through legal_section, so by the time
  this layout runs the list is complete. Wraps the marketing layout.
%>
<% content_for :page_body do %>
  <div class="mx-auto max-w-6xl px-4 pb-20 pt-8 sm:px-6 sm:pt-14">
    <div class="grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
      <div class="min-w-0 lg:col-start-2">
      <header>
        <h1 class="type-display text-[2rem] text-balance text-ink sm:text-5xl"><%= yield :title %></h1>
        <p class="mt-4 text-sm text-ink-subtle">Last updated <time datetime="<%= Legal::LAST_UPDATED.iso8601 %>"><%= l Legal::LAST_UPDATED, format: :legal %></time></p>
        <% unless Legal.configured? %>
          <p class="mt-4 max-w-prose rounded-control bg-warning-50 px-4 py-3 text-sm font-medium text-warning-700" role="note">
            Placeholder details: the operator’s name and email aren’t set yet (LEGAL_OWNER_NAME, SUPPORT_EMAIL).
          </p>
        <% end %>
      </header>

      <article class="legal-prose mt-8">
        <%= yield %>

        <aside class="mt-16 border-t border-line pt-8" aria-label="Related policies">
          <p class="text-sm text-ink-muted">Related:
            <%= safe_join(legal_related_links.map { |label, path| link_to(label, path) }, ", ") %>
          </p>
        </aside>
      </article>
      </div>

      <% if legal_toc.many? %>
        <nav aria-labelledby="toc-heading" class="hidden lg:block lg:col-start-1 lg:row-start-1">
          <div class="lg:sticky lg:top-8">
            <h2 id="toc-heading" class="text-sm font-semibold text-ink">On this page</h2>
            <ol class="mt-3 space-y-1 border-l border-line text-sm">
              <% legal_toc.each do |id, title| %>
                <li><a href="#<%= id %>" class="-ml-px block border-l border-transparent py-1 pl-4 text-ink-muted hover:border-ink-subtle hover:text-ink"><%= title %></a></li>
              <% end %>
            </ol>
          </div>
        </nav>
      <% end %>

    </div>
  </div>
<% end %>
<%= render template: "layouts/marketing" %>
