<%# The note editor. Esc or Cancel closes it without saving (note_editor_controller.js). %>
<%= turbo_frame_tag dom_id(path_step, :note), class: "mt-4 block" do %>
  <%= form_with model: path_step, url: path_step_note_path(path_step), method: :patch, namespace: dom_id(path_step),
        class: "max-w-prose space-y-3",
        data: { controller: "note-editor", action: "keydown.esc->note-editor#cancel" } do |form| %>
    <%= render "shared/field", form: form, attribute: :note, as: :text_area,
          label: safe_join([ "Your note", tag.span(" for “#{path_step.title}”", class: "sr-only") ]),
          hint: "Only you can see it. Leave it empty to remove the note.",
          input: { rows: 4, maxlength: PathStep::NOTE_MAX_LENGTH, autofocus: true, class: "resize-y" } %>
    <div class="flex flex-wrap items-center gap-2">
      <%= form.submit "Save note", class: ui_button_classes(size: :sm), data: { turbo_submits_with: "Saving…" } %>
      <%= link_to "Cancel", path_step_note_path(path_step), class: ui_button_classes(variant: :ghost, size: :sm),
            data: { note_editor_target: "cancel" } %>
    </div>
  <% end %>
<% end %>
