<% content_for :title, "Sign in" %>
<% content_for :meta_description, "Sign in to Path Aviator to pick up your learning path where you left off." %>

<h1 class="type-display text-2xl text-ink sm:text-[1.75rem]">Welcome back</h1>
<p class="mt-2 text-pretty text-ink-muted">Sign in to pick up your learning path where you left off.</p>

<%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
  <%= render "shared/field", form: form, attribute: :email_address, label: "Email", as: :email_field,
        input: { value: params[:email_address], required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com" } %>

  <div>
    <%= render "shared/field", form: form, attribute: :password, label: "Password", as: :password_field, reveal: true,
          input: { required: true, autocomplete: "current-password", maxlength: 72 } %>
    <p class="mt-2 text-right text-sm">
      <%= link_to "Forgot your password?", new_password_path, class: "font-medium text-brand-700 underline-offset-4 hover:underline" %>
    </p>
  </div>

  <%= form.submit "Sign in", class: ui_button_classes(size: :lg, block: true), data: { turbo_submits_with: "Signing in…" } %>
<% end %>

<% content_for :below_card do %>
  New to Path Aviator?
  <%= link_to "Create an account", new_registration_path, class: "font-semibold text-brand-700 underline-offset-4 hover:underline" %>
<% end %>
