<%# The route: one waypoint per step. Replaced over a Turbo Stream (morph) when a step is ticked. %>
<% steps = local_assigns[:steps] || learning_path.path_steps.to_a %>
<% next_step = learning_path.next_step %>
<ol id="<%= dom_id(learning_path, :steps) %>" class="mt-6">
  <% steps.each do |step| %>
    <%= render "path_steps/path_step", path_step: step, up_next: step == next_step, last: step == steps.last %>
  <% end %>
</ol>
