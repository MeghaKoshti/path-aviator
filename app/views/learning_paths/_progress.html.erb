<%# Progress summary. Replaced over a Turbo Stream whenever a step is ticked. %>
<% next_step = learning_path.next_step %>
<div id="<%= dom_id(learning_path, :progress) %>" class="rounded-panel border border-line bg-surface-raised p-5 shadow-panel">
  <%= render "shared/progress_bar", value: learning_path.progress_percent, label: "Progress on this path" %>

  <dl class="mt-4 grid grid-cols-2 gap-4">
    <div>
      <dt class="text-sm text-ink-subtle">Steps done</dt>
      <dd class="mt-0.5 text-xl font-semibold tabular-nums text-ink"><%= learning_path.completed_steps_count %> of <%= learning_path.path_steps_count %></dd>
    </div>
    <div>
      <dt class="text-sm text-ink-subtle">Time left</dt>
      <dd class="mt-0.5 text-xl font-semibold tabular-nums text-ink"><%= learning_path.completed? ? "None" : format_minutes(learning_path.remaining_minutes) %></dd>
    </div>
  </dl>

  <div class="mt-4 border-t border-line pt-4 text-sm">
    <% if learning_path.completed? %>
      <p class="font-semibold text-success-700">You’ve finished every step.</p>
      <p class="mt-1 text-ink-muted">Where to next?</p>
      <div class="mt-3"><%= ui_button "Plan another path", new_learning_goal_path, size: :sm %></div>
    <% elsif next_step %>
      <p class="text-ink-subtle">Up next</p>
      <%= link_to next_step.title, "##{dom_id(next_step)}", class: "mt-0.5 block font-semibold text-brand-700 underline-offset-4 hover:underline" %>
    <% end %>
  </div>
</div>
