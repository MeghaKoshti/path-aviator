<%#
  The whole path page body. GenerateLearningPathJob re-renders this partial
  and broadcasts it (replace by dom_id) when the path is ready or has failed,
  so it must not depend on the request (no Current, no params).
%>
<%
  status_message = case learning_path.status
                   when "ready" then "Your path is ready: #{pluralize(learning_path.path_steps_count, "step")}."
                   when "failed" then "We couldn’t plan this path. You can try again."
                   else "Planning your path to #{learning_path.learning_goal.topic}. This page updates when it’s ready."
                   end
%>
<div id="<%= dom_id(learning_path) %>"
     data-controller="path-status"
     data-path-status-status-value="<%= learning_path.status %>"
     data-path-status-message-value="<%= status_message %>"
     data-path-status-refresh-after-value="<%= learning_path.generating? ? 20_000 : 0 %>"
     data-path-status-status-url-value="<%= learning_path_path(learning_path, format: :json) %>">
  <%# One partial per status: _generating, _ready, _failed. %>
  <%= render "learning_paths/#{learning_path.status}", learning_path: learning_path %>
</div>
