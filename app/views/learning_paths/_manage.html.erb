<%# Regenerate or delete. Both ask first because neither can be undone. %>
<%# Also rendered by broadcasts, so the owner comes from the path, not Current. %>
<% name = learning_path.title.presence || learning_path.learning_goal.topic %>
<% out_of_paths = learning_path.user.generation_quota.refusal == :limit %>
<div class="rounded-panel border border-line p-5">
  <h2 class="text-sm font-semibold text-ink">Not the right route?</h2>
  <p class="mt-1 text-sm text-pretty text-ink-muted">Regenerate for a fresh plan with the same goal. Your ticked steps and notes are cleared.</p>
  <div class="mt-4 flex flex-wrap gap-2">
    <% unless out_of_paths %>
      <%= ui_button "Regenerate", regenerate_learning_path_path(learning_path), method: :post, variant: :secondary, size: :sm,
            data: { turbo_confirm: "Regenerate “#{name}”? You’ll get new steps, and your progress and notes will be cleared." } %>
    <% end %>
    <%= ui_button "Delete path", learning_path_path(learning_path), method: :delete, variant: :danger_ghost, size: :sm,
          data: { turbo_confirm: "Delete “#{name}”? Its steps and progress will be gone for good." } %>
  </div>
  <% if out_of_paths %>
    <div class="mt-4"><%= render "shared/upgrade_prompt", reason: :limit, user: learning_path.user, compact: true %></div>
  <% end %>
</div>
