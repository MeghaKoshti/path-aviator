<%# Regenerate or delete. Both ask first because neither can be undone. %>
<% name = learning_path.title.presence || learning_path.learning_goal.topic %>
<div class="rounded-panel border border-line p-5">
  <h2 class="text-sm font-semibold text-ink">Not the right route?</h2>
  <p class="mt-1 text-sm text-pretty text-ink-muted">Regenerate for a fresh plan with the same goal. Your ticked steps are cleared.</p>
  <div class="mt-4 flex flex-wrap gap-2">
    <%= ui_button "Regenerate", regenerate_learning_path_path(learning_path), method: :post, variant: :secondary, size: :sm,
          data: { turbo_confirm: "Regenerate “#{name}”? You’ll get new steps and your progress will be cleared." } %>
    <%= ui_button "Delete path", learning_path_path(learning_path), method: :delete, variant: :danger_ghost, size: :sm,
          data: { turbo_confirm: "Delete “#{name}”? Its steps and progress will be gone for good." } %>
  </div>
</div>
