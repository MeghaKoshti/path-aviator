<% goal = learning_path.learning_goal %>
<section class="mx-auto max-w-2xl" aria-labelledby="<%= dom_id(learning_path, :heading) %>">
  <div class="overflow-hidden rounded-panel border border-line bg-surface-raised shadow-panel">
    <%# A route being charted: the dashed line marches toward the plane while waypoints light up in turn. %>
    <div class="bg-chart-grid border-b border-line bg-surface px-4 py-6 sm:px-8" aria-hidden="true">
      <svg class="h-auto w-full" viewBox="0 0 480 120" fill="none">
        <path d="M24 96 C 90 96, 110 50, 170 56 S 260 92, 320 70 S 400 26, 446 24"
              class="stroke-route animate-route-march motion-reduce:animate-none" stroke-width="2.5" stroke-dasharray="6 7" stroke-linecap="round"/>
        <circle cx="24" cy="96" r="7" class="fill-route"/>
        <circle cx="170" cy="56" r="6" class="fill-surface-raised stroke-route animate-waypoint motion-reduce:animate-none" stroke-width="2.5"/>
        <circle cx="320" cy="70" r="6" class="fill-surface-raised stroke-route animate-waypoint [animation-delay:600ms] motion-reduce:animate-none" stroke-width="2.5"/>
        <g class="animate-cruise motion-reduce:animate-none">
          <path d="M446 12 l12 20 h-24 z" class="fill-brand-700"/>
        </g>
      </svg>
    </div>

    <div class="p-6 sm:p-8">
      <h1 id="<%= dom_id(learning_path, :heading) %>" class="type-display text-2xl text-balance text-ink sm:text-3xl">
        Charting your route to <%= goal.topic %>
      </h1>
      <p class="mt-3 flex items-start gap-2.5 text-pretty text-ink-muted">
        <svg class="mt-0.5 size-5 shrink-0 animate-spin text-brand-600 motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity="0.2"/>
          <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span>Path Aviator is picking courses, docs and practice for you. This usually takes under a minute, and this page updates on its own.</span>
      </p>

      <dl class="mt-6 grid gap-4 border-t border-line pt-6 sm:grid-cols-3">
        <div>
          <dt class="text-sm text-ink-subtle">Level</dt>
          <dd class="mt-1 font-semibold text-ink"><%= goal_level_label(goal) %></dd>
        </div>
        <div>
          <dt class="text-sm text-ink-subtle">Time</dt>
          <dd class="mt-1 font-semibold text-ink"><%= goal_pace_label(goal) %></dd>
        </div>
        <% if goal.goal_description %>
          <div class="sm:col-span-3">
            <dt class="text-sm text-ink-subtle">Your goal</dt>
            <dd class="mt-1 text-ink"><%= goal.goal_description %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</section>
