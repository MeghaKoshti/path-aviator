<% goal = learning_path.learning_goal %>
<section class="mx-auto max-w-xl" aria-labelledby="<%= dom_id(learning_path, :heading) %>">
  <div class="rounded-panel border border-line bg-surface-raised p-6 text-center shadow-panel sm:p-10">
    <%# A route that breaks off before reaching the destination. %>
    <svg class="mx-auto mb-6 h-14 w-32 text-route" viewBox="0 0 128 56" fill="none" aria-hidden="true">
      <path d="M8 46 C 30 46, 34 16, 58 18" stroke="currentColor" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round"/>
      <circle cx="8" cy="46" r="5" class="fill-surface-raised" stroke="currentColor" stroke-width="2"/>
      <path d="M72 14 l8 8 M80 14 l-8 8" class="stroke-danger-600" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M96 30 S 108 20, 118 12" class="stroke-line-strong" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round"/>
    </svg>
    <h1 id="<%= dom_id(learning_path, :heading) %>" class="type-display text-2xl text-balance text-ink sm:text-3xl">
      We couldn’t plan your route to <%= goal.topic %>
    </h1>
    <p class="mt-3 text-pretty text-ink-muted">
      <%= learning_path.error_message.presence || "Something went wrong while planning this path." %>
      Your answers are saved.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <%= ui_button "Try again", regenerate_learning_path_path(learning_path), method: :post, size: :lg %>
      <%= ui_button "Plan a different path", new_learning_goal_path, variant: :secondary, size: :lg %>
    </div>
  </div>
</section>
