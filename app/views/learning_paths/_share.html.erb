<%#
  Owner controls for the path's public link. Part of the broadcast path
  partial, so it must not depend on the request: the link's origin is filled
  in by clipboard_controller.js from the page the owner is on.
%>
<section id="share" aria-labelledby="<%= dom_id(learning_path, :share_heading) %>" class="scroll-mt-24 rounded-panel border border-line p-5">
  <div class="flex items-center justify-between gap-2">
    <h2 id="<%= dom_id(learning_path, :share_heading) %>" class="text-sm font-semibold text-ink">Share this path</h2>
    <%= ui_badge "Shared", :success if learning_path.shared? %>
  </div>
  <p class="mt-1 text-sm text-pretty text-ink-muted">
    Anyone with the link can see the steps and your progress. Your notes and email stay private.
  </p>

  <% if learning_path.shared? %>
    <div class="mt-4" data-controller="clipboard" data-clipboard-path-value="<%= shared_path_path(learning_path.share_token) %>">
      <label for="<%= dom_id(learning_path, :share_url) %>" class="sr-only">Share link</label>
      <input type="text" readonly id="<%= dom_id(learning_path, :share_url) %>" value="<%= shared_path_url(learning_path.share_token) %>"
             class="<%= ui_input_classes %>"
             data-clipboard-target="source" data-action="focus->clipboard#select">
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        <%= ui_button "Copy link", size: :sm, data: { action: "clipboard#copy" } %>
        <p class="text-sm font-medium text-success-700" role="status" data-clipboard-target="status"></p>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
      <%= ui_button "New link", learning_path_share_path(learning_path), method: :post, variant: :secondary, size: :sm,
            data: { turbo_confirm: "Make a new link? The current link will stop working." } %>
      <%= ui_button "Stop sharing", learning_path_share_path(learning_path), method: :delete, variant: :danger_ghost, size: :sm,
            data: { turbo_confirm: "Stop sharing? The link will stop working." } %>
    </div>
  <% else %>
    <div class="mt-4">
      <%= ui_button "Create share link", learning_path_share_path(learning_path), method: :post, variant: :secondary, size: :sm %>
    </div>
  <% end %>
</section>
