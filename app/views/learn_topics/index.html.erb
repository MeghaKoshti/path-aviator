<% content_for :title, "Study plans for developers" %>
<% content_for :meta_description, "Free week-by-week study plans for developers switching jobs: system design, DSA, Rails, React, Go, SQL, Docker, AWS, Git and interview prep." %>

<div class="mx-auto max-w-6xl px-4 pb-20 pt-8 sm:px-6 sm:pt-14">
  <header class="max-w-2xl">
    <h1 class="type-display text-[2.25rem] text-balance text-ink sm:text-5xl">Study plans for developers</h1>
    <p class="mt-5 text-lg leading-relaxed text-pretty text-ink-muted">
      Week-by-week plans for the skills job posts ask for, sized for evenings after work.
      Every step links to a free resource we’ve checked. Make one yours to track it, or plan your own from a job post.
    </p>
  </header>

  <ul class="mt-12 grid gap-5 md:grid-cols-2" role="list">
    <% @topics.each do |topic| %>
      <li class="relative flex flex-col rounded-panel border border-line bg-surface-raised p-6 shadow-panel transition-colors hover:border-brand-300">
        <h2 class="text-lg font-semibold text-balance text-ink">
          <%= link_to topic.title, learn_topic_path(topic), class: "after:absolute after:inset-0 after:rounded-panel" %>
        </h2>
        <p class="mt-2 text-pretty text-ink-muted"><%= topic.summary %></p>
        <div class="mt-auto flex flex-wrap gap-2 pt-5">
          <%= ui_badge topic.level.capitalize, :brand %>
          <%= ui_badge learn_topic_facts(topic) %>
          <%= ui_badge pluralize(topic.steps.size, "step") %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
