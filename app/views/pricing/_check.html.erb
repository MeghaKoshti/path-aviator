<%# A table cell value: true (included), false (not included) or a short note. Local: value: %>
<% if value == true %>
  <svg class="size-5 text-success-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
  <span class="sr-only">Included</span>
<% elsif value == false %>
  <span class="text-ink-subtle" aria-hidden="true">–</span>
  <span class="sr-only">Not included</span>
<% else %>
  <span class="text-ink"><%= value %></span>
<% end %>
