<%#
  Segmented toggle for the pricing controller. Locals: label:, kind: :interval or :currency,
  options: [[value, label_html], ...], current:
%>
<div role="group" aria-label="<%= label %>" class="inline-flex rounded-full bg-surface-sunken p-1 ring-1 ring-inset ring-line">
  <% options.each do |value, option_label| %>
    <button type="button"
            class="flex min-h-10 cursor-pointer items-center gap-2 rounded-full px-4 text-sm font-semibold text-ink-muted transition-colors hover:text-ink aria-pressed:bg-surface-raised aria-pressed:text-ink aria-pressed:shadow-sm"
            aria-pressed="<%= value == current %>"
            data-value="<%= value %>"
            data-pricing-target="<%= kind %>Button"
            data-action="pricing#choose<%= kind.to_s.capitalize %>">
      <%= option_label %>
    </button>
  <% end %>
</div>
